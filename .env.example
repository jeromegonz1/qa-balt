# QA-BALT — Configuration serveur
# Copier ce fichier en .env et remplir les valeurs

# Port du serveur (défaut: 3847)
PORT=3847

# ClickUp API Token
# Générer dans ClickUp → Settings → Apps → Generate API Token
CLICKUP_API_TOKEN=pk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optionnel : changer le statut de la tâche après le QA
# Laisser vide pour ne pas changer le statut
CLICKUP_STATUS_QA_OK=QA OK
CLICKUP_STATUS_QA_KO=QA KO

# SE Ranking API Token (pour Core Web Vitals — Sprint 4)
# Obtenir dans SE Ranking → Settings → API
SERANKING_API_TOKEN=

# Token debug AZKO (active oJsonFeedback inline → metadonnees + erreurs PHP)
# A demander a l'equipe dev AZKO. Skip silencieux si absent.
AZKO_DEBUG_TOKEN=

# URL publique du serveur qa-balt (utilise pour generer des URLs absolues
# vers les screenshots dans le rapport HTML — permet de partager le HTML
# par mail/ClickUp avec les images qui restent visibles).
# Si vide : URLs relatives (n'affichent les images QUE si le rapport est
# servi par qa-balt directement).
QA_BALT_PUBLIC_URL=http://qabalt.fire-snake-301.fr
